                <mxCell id="legend_alu_src" value="alu_src: ALU source select (0=reg, 1=imm)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingTop=4;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
